# Copy to .env (never commit .env).
PORT=4000
FRONTEND_URL=http://localhost:3000

# MySQL (XAMPP). Recommended: dedicated user from database/create-user.sql.
# Quick local alternative: DB_USER=root with an empty DB_PASSWORD (XAMPP default).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=valostock
DB_PASSWORD=valostock_dev
DB_NAME=valostock

# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# simulation = built-in fake payment page (no keys needed)
# midtrans   = real Midtrans Snap Sandbox (fill the keys below)
PAYMENT_MODE=simulation
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
