# Copy to .env (never commit .env). Supabase values: `npx supabase status` (from the repo root).
PORT=4000
FRONTEND_URL=http://localhost:3000

# Postgres of the local Supabase project "valostock" — the API's own role (password set in supabase/seed.sql)
DATABASE_URL=postgresql://valostock_api:valostock_api_dev@127.0.0.1:55322/postgres

# Supabase Auth + Storage (server only — never expose the service role key to the browser)
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# simulation = built-in fake payment page (no keys needed)
# midtrans   = real Midtrans Snap Sandbox (fill the keys below)
PAYMENT_MODE=simulation
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Background jobs (expiries, auto-complete). Set to false to run them manually.
JOBS_ENABLED=true
